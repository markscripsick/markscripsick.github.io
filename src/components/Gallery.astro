---
/**
 * Reusable image gallery with an accessible lightbox.
 *
 * Usage (already wired into project pages — you just fill `gallery` in a
 * project's frontmatter):
 *
 *   <Gallery images={project.data.gallery} />
 *
 * Each image is { src, alt, caption? }. Drop your SolidWorks renders,
 * photos, and screenshots into /public/images/... and reference the path.
 *
 * Props you can tune when reusing it elsewhere:
 *   label  — small mono heading above the grid ('' hides it)
 *   fit    — 'cover' crops to fill the tile (photos);
 *            'contain' shows the WHOLE image (use for FEA plots, drawings,
 *            or anything with a legend/labels you must not crop)
 *   ratio  — tile aspect ratio, e.g. '4 / 3' or '16 / 9'
 *   min    — minimum tile width before the grid wraps
 */
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: GalleryImage[];
  label?: string;
  fit?: 'cover' | 'contain';
  ratio?: string;
  min?: string;
}
const {
  images,
  label = 'Gallery',
  fit = 'cover',
  ratio = '4 / 3',
  min = '220px',
} = Astro.props;
---

{
  images.length > 0 && (
    <section
      class="gallery"
      aria-label={label || 'Image gallery'}
      data-fit={fit}
      style={`--g-fit:${fit};--g-ratio:${ratio};--g-min:${min};`}
    >
      {label && <p class="g-label">{label}</p>}
      <ul class="grid">
        {images.map((img, i) => (
          <li>
            <button
              class="tile"
              type="button"
              data-index={i}
              aria-label={`Open image: ${img.alt}`}
            >
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                width="600"
                height="450"
              />
            </button>
            {img.caption && <p class="t-cap">{img.caption}</p>}
          </li>
        ))}
      </ul>

      <dialog class="lightbox" aria-label="Image viewer">
        <button class="lb-close" type="button" aria-label="Close (Esc)">
          ✕
        </button>
        <button class="lb-nav lb-prev" type="button" aria-label="Previous image">
          ‹
        </button>
        <figure class="lb-figure">
          <img class="lb-img" src="" alt="" />
          <figcaption class="lb-caption" />
        </figure>
        <button class="lb-nav lb-next" type="button" aria-label="Next image">
          ›
        </button>
      </dialog>

      <script
        is:inline
        define:vars={{ images }}
      >
        (() => {
          const root = document.currentScript.closest('.gallery');
          const dialog = root.querySelector('.lightbox');
          const lbImg = root.querySelector('.lb-img');
          const lbCap = root.querySelector('.lb-caption');
          const single = images.length < 2;
          let current = 0;

          const show = (i) => {
            current = (i + images.length) % images.length;
            const img = images[current];
            lbImg.src = img.src;
            lbImg.alt = img.alt;
            lbCap.textContent = img.caption || '';
            lbCap.style.display = img.caption ? '' : 'none';
          };

          root.querySelectorAll('.tile').forEach((btn) => {
            btn.addEventListener('click', () => {
              show(Number(btn.dataset.index));
              dialog.showModal();
            });
          });

          root.querySelector('.lb-close').addEventListener('click', () =>
            dialog.close(),
          );
          const prev = root.querySelector('.lb-prev');
          const next = root.querySelector('.lb-next');
          // Hide the arrows when there's nothing to navigate to.
          if (single) {
            prev.hidden = true;
            next.hidden = true;
          }
          prev.addEventListener('click', () => show(current - 1));
          next.addEventListener('click', () => show(current + 1));

          dialog.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') show(current + 1);
            if (e.key === 'ArrowLeft') show(current - 1);
          });
          // Click on backdrop closes.
          dialog.addEventListener('click', (e) => {
            if (e.target === dialog) dialog.close();
          });
        })();
      </script>
    </section>
  )
}

<style>
  .gallery {
    margin-top: 2rem;
  }
  .g-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.7rem;
    color: var(--ink-faint);
    margin: 0 0 1rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--g-min), 1fr));
    gap: 1rem;
  }
  .grid > li {
    min-width: 0;
  }
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    cursor: zoom-in;
    background: var(--surface-2);
    aspect-ratio: var(--g-ratio);
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--ink-faint);
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: var(--g-fit);
  }
  /* Technical plots: show the whole frame, never crop the legend. */
  .gallery[data-fit='contain'] .tile {
    background: var(--paper-hi);
  }
  .gallery[data-fit='contain'] .tile img {
    padding: 0.4rem;
  }
  .t-cap {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--ink-faint);
  }

  .lightbox {
    border: none;
    background: transparent;
    max-width: 96vw;
    max-height: 96vh;
    padding: 0;
    margin: auto;
    color: var(--bg);
  }
  .lightbox::backdrop {
    background: rgba(24, 22, 17, 0.9);
    backdrop-filter: blur(3px);
  }
  .lb-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .lb-img {
    max-width: 88vw;
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 4px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .lb-caption {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.7rem;
    color: #ece7db;
    text-align: center;
    max-width: 60ch;
  }
  .lb-close,
  .lb-nav {
    position: fixed;
    background: rgba(244, 241, 234, 0.12);
    color: #f4f1ea;
    border: 1px solid rgba(244, 241, 234, 0.28);
    width: 48px;
    height: 48px;
    border-radius: 999px;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background-color 0.2s var(--ease);
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: rgba(244, 241, 234, 0.24);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  @media (max-width: 640px) {
    .lb-prev {
      left: 0.4rem;
    }
    .lb-next {
      right: 0.4rem;
    }
  }
</style>
