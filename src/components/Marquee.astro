---
/**
 * Auto-scrolling image strip (marquee).
 *
 * Driven entirely by SHOWCASE in src/config.ts — you add or remove images
 * there, never here.
 *
 *   direction="x"  horizontal strip (default), for full-width sections
 *   direction="y"  vertical filmstrip, sized to fill its parent — this is
 *                  what the home hero uses in place of a static photo.
 *                  It automatically falls back to a horizontal strip on
 *                  narrow screens, where a tall column has no room.
 *
 * Behaviour notes:
 *  • The image set is rendered twice and the track is moved by exactly -50%,
 *    so the loop is seamless. Every item carries its own trailing margin
 *    (rather than using flex `gap`), which is what makes the two halves
 *    exactly equal.
 *  • The second copy is aria-hidden with empty alt text, so screen readers
 *    only ever encounter each image once.
 *  • Scrolling pauses on hover and on keyboard focus.
 *  • With "reduce motion" enabled the animation is off entirely and the
 *    strip becomes a normal scroller.
 *  • Images use object-fit: contain inside a fixed frame, so nothing is ever
 *    cropped and there is no layout shift while they load.
 */
interface Item {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: readonly Item[];
  label?: string;
  /** Seconds for one full loop. Larger = slower. */
  seconds?: number;
  /** 'x' = horizontal strip, 'y' = vertical filmstrip. */
  direction?: 'x' | 'y';
}
const { images, label = '', seconds = 80, direction = 'x' } = Astro.props;
---

{
  images.length > 0 && (
    <div class="showcase" data-dir={direction} aria-label={label || 'Selected work'} role="region">
      {label && (
        <div class="container">
          <p class="eyebrow">{label}</p>
        </div>
      )}

      <div class="marquee">
        <ul class="track" style={`--dur:${seconds}s`}>
          {images.map((img) => (
            <li class="item">
              <figure class="fig">
                <div class="frame">
                  <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                </div>
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            </li>
          ))}
          {/* Duplicate set — purely visual, hidden from assistive tech. */}
          {images.map((img) => (
            <li class="item dup" aria-hidden="true">
              <figure class="fig">
                <div class="frame">
                  <img src={img.src} alt="" loading="lazy" decoding="async" />
                </div>
                {img.caption && <figcaption>{img.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )
}

<style>
  .marquee {
    overflow: hidden;
  }
  .track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    animation-duration: var(--dur, 80s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  .item {
    flex: none;
  }

  /* Pause when the user is looking at it or tabbing through it */
  .marquee:hover .track,
  .marquee:focus-within .track {
    animation-play-state: paused;
  }

  .fig {
    margin: 0;
  }
  .frame {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }
  .frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  figcaption {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.62rem;
    line-height: 1.5;
    color: var(--ink-faint);
  }

  @keyframes slideX {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes slideY {
    to {
      transform: translateY(-50%);
    }
  }

  /* ── Horizontal strip ─────────────────────────────────────────────── */
  [data-dir='x'] {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border-soft);
  }
  [data-dir='x'] .marquee {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  [data-dir='x'] .track {
    flex-direction: row;
    width: max-content;
    animation-name: slideX;
  }
  [data-dir='x'] .item {
    width: 300px;
    margin-right: 1rem;
  }
  [data-dir='x'] .frame {
    height: 210px;
  }

  /* ── Vertical filmstrip (fills its parent) ────────────────────────── */
  [data-dir='y'] {
    height: 100%;
  }
  [data-dir='y'] .marquee {
    height: 100%;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 7%, #000 93%, transparent);
  }
  [data-dir='y'] .track {
    flex-direction: column;
    width: 100%;
    height: max-content;
    animation-name: slideY;
  }
  [data-dir='y'] .item {
    width: 100%;
    margin-bottom: 1rem;
  }
  [data-dir='y'] .frame {
    height: clamp(190px, 26vh, 250px);
  }

  /*
    Narrow screens: a tall column has nowhere to go once the hero stacks,
    so the vertical strip becomes a horizontal one.
  */
  @media (max-width: 820px) {
    [data-dir='y'] .marquee {
      height: auto;
      padding-inline: 0;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    [data-dir='y'] .track {
      flex-direction: row;
      width: max-content;
      height: auto;
      animation-name: slideX;
    }
    [data-dir='y'] .item {
      width: 240px;
      margin-right: 0.85rem;
      margin-bottom: 0;
    }
    [data-dir='y'] .frame {
      height: 170px;
    }
  }

  @media (max-width: 640px) {
    [data-dir='x'] .item {
      width: 220px;
      margin-right: 0.75rem;
    }
    [data-dir='x'] .frame {
      height: 155px;
    }
  }

  /* Motion-sensitive users: no animation, manual scrolling instead. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
    }
    .dup {
      display: none;
    }
    [data-dir='x'] .marquee,
    [data-dir='y'] .marquee {
      overflow: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    [data-dir='y'] .track {
      width: 100%;
    }
  }
</style>
